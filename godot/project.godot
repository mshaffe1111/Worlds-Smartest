; Engine configuration file.
; World's Smartest — AAA Godot 4.7.2 Sovereign Modernism 3D Mobile & Web Build

config_version=5

[application]

config/name="World's Smartest"
config/description="World's Smartest — AAA 3D Horological Trivia & 40-Mission Global Espionage Thriller"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility", "Mobile")
config/icon="res://icon.svg"

[autoload]

TriviaDB="*res://scripts/TriviaDatabase.gd"
AudioDirector="*res://scripts/AudioDirector.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.0235294, 0.0352941, 0.0627451, 1)

[importer_defaults]

texture={
"compress/high_quality": false,
"compress/lossy_quality": 0.86,
"compress/mode": 1,
"mipmaps/generate": true,
"process/size_limit": 1536
}

